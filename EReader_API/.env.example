# Copie para .env e ajuste. O .env NÃO é versionado.
# Consumido por: docker compose -f EReader_API/docker-compose.yml up
# (interpolação de ${VAR} no docker-compose.yml)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ereader

# Spec 01 (Identidade) — gerar com >= 32 bytes aleatórios em base64, ex.:
#   PowerShell: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SIGNING_KEY=
