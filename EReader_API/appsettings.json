{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "ereader-api",
    "Audience": "ereader-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "FileStorage": {
    "RootPath": "App_Data/books",
    "MaxUploadBytes": 52428800
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
